<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PadExtend.Sender</AssemblyName>
    <RootNamespace>PadExtend.Sender</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(ProjectDir)..\PadExtend.Encoder\PadExtend.Encoder.dll"
          Condition="Exists('$(ProjectDir)..\PadExtend.Encoder\PadExtend.Encoder.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>PadExtend.Encoder.dll</Link>
    </None>
  </ItemGroup>

</Project>
